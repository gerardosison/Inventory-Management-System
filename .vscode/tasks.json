{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build raylib project",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${file}",
                "-o", "${fileDirname}/${fileBasenameNoExtension}.exe",
                "-I", "C:/raylib/raylib/src",
                "-L", "C:/raylib/raylib/src",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm",
                "-Wall", "-g"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}